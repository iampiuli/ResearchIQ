# --- App metadata ---
APP_NAME=ResearchIQ
APP_ENV=development
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated list of allowed origins) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth (Clerk) --- required; every API route needs a signed-in user.
# Both come from your Clerk "Frontend API URL" (Clerk dashboard -> API keys).
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev

# --- File storage ---
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=50

# --- Google Gemini (required for /chat) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- ChromaDB ---
CHROMA_PERSIST_DIR=app/database/chroma_store
CHROMA_COLLECTION_NAME=researchiq

# --- Embeddings ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Logging ---
LOG_LEVEL=INFO
